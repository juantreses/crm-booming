<div class="panel panel-default">
    <div class="panel-body">
        <div class="row">
            <div class="col-md-12">
                <div class="form-group">
                    <label>Beschikbaar moment *</label>
                    <select name="selectedSlot" class="form-control">
                        <option value="">Laden...</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="row" data-field="spark-cup">
            <div class="col-md-12">
                <div class="checkbox">
                    <label>
                        <input type="checkbox" name="isSparkCup"> SPARK cup
                    </label>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-12">
                <div class="form-group">
                    <label>Aanvullende notitie</label>
                    <textarea name="coachNote" class="form-control" rows="4" placeholder="Voeg een extra notitie toe..."></textarea>
                </div>
            </div>
        </div>
    </div>
</div>
