            "isCustom": true
        },
        "buik": {
            "notNull": false,
            "type": "float",
            "required": false,
            "min": 40,
            "max": 200,
            "decimalPlaces": 1,
            "readOnlyAfterCreate": false,
            "isCustom": true
        },
        "heup": {
            "notNull": false,
            "type": "float",
            "required": false,
            "min": 50,
            "max": 200,
            "decimalPlaces": 1,
