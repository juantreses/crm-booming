<?xml version="1.0"?>
<ruleset name="crm-booming">
    <description>Coding standard for our own code in custom/ (PSR-12 + a few Slevomat rules).</description>

    <file>custom/Espo</file>
    <exclude-pattern>custom/Espo/Modules/*/vendor/*</exclude-pattern>
    <!-- Licensed EspoCRM extension: replaced on extension updates, not our code. -->
    <exclude-pattern>custom/Espo/Modules/Google/*</exclude-pattern>

    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg name="parallel" value="8"/>
    <arg name="cache" value=".phpcs-cache"/>
    <arg value="sp"/>

    <rule ref="PSR12"/>

    <!-- Keep imports tidy (also what Rector's removeUnusedImports expects). -->
    <rule ref="SlevomatCodingStandard.Namespaces.UnusedUses">
        <properties>
            <property name="searchAnnotations" value="true"/>
        </properties>
    </rule>
    <rule ref="SlevomatCodingStandard.Namespaces.AlphabeticallySortedUses"/>
    <rule ref="SlevomatCodingStandard.Arrays.TrailingArrayComma"/>
    <rule ref="SlevomatCodingStandard.Functions.RequireTrailingCommaInCall"/>
    <rule ref="SlevomatCodingStandard.Functions.RequireTrailingCommaInDeclaration"/>
</ruleset>
