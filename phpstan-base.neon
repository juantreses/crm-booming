# Shared PHPStan settings. phpstan.neon.dist adds the baseline on top;
# `bin/qa stan-all` uses this file alone to show the baselined errors too, with line numbers.

parameters:
    level: 5
    phpVersion: 80300
    paths:
        - custom/Espo
    excludePaths:
        - custom/Espo/Modules/*/vendor/*
        # Licensed EspoCRM extension: replaced on extension updates, not our code.
        - custom/Espo/Modules/Google/*
    # Espo's autoloader knows Espo\, Espo\Custom\ and Espo\Modules\.
    bootstrapFiles:
        - vendor/autoload.php
    tmpDir: data/tmp/phpstan
