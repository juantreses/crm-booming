#!/usr/bin/env bash
# Code quality tools (Rector + PHP_CodeSniffer) for our own code in custom/.
#
# Runs inside the espocrm Docker container when called from the host,
# or directly when php is already available (e.g. inside the container).
#
#   bin/qa install     install the tools into tools/vendor (once, and after tools/composer.json changes)
#   bin/qa lint        php -l syntax check on custom/
#   bin/qa cs          PHP_CodeSniffer report
#   bin/qa cs-fix      auto-fix what phpcbf can fix
#   bin/qa rector      Rector dry-run (shows the diff, changes nothing)
#   bin/qa rector-fix  apply Rector changes
#   bin/qa all         lint + cs + rector dry-run (good before every commit)
#
# Extra arguments are passed to the tool, e.g. `bin/qa cs custom/Espo/Modules/Booking`.
set -euo pipefail

CONTAINER="${ESPO_CONTAINER:-espocrm}"
APP_DIR="${ESPO_APP_DIR:-/var/www/html}"

# Re-exec inside the container when we're on the host.
if [[ -z "${QA_IN_CONTAINER:-}" ]] && command -v docker >/dev/null 2>&1 \
    && docker ps --format '{{.Names}}' | grep -qx "$CONTAINER"; then
    tty_flag=""
    [[ -t 1 ]] && tty_flag="-t"
    exec docker exec -i $tty_flag -u www-data -e QA_IN_CONTAINER=1 -w "$APP_DIR" \
        "$CONTAINER" bash bin/qa "$@"
fi

cd "$(dirname "$0")/.."
BIN=tools/vendor/bin
cmd="${1:-all}"
shift || true

require_tools() {
    if [[ ! -x "$BIN/rector" || ! -x "$BIN/phpcs" ]]; then
        echo "Tools not installed. Run: bin/qa install" >&2
        exit 1
    fi
}

case "$cmd" in
    install)
        if ! command -v composer >/dev/null 2>&1; then
            echo "Downloading composer into tools/ ..."
            php -r "copy('https://getcomposer.org/installer', 'tools/composer-setup.php');"
            php tools/composer-setup.php --quiet --install-dir=tools --filename=composer.phar
            rm tools/composer-setup.php
            COMPOSER="php tools/composer.phar"
        else
            COMPOSER="composer"
        fi
        COMPOSER_HOME="${COMPOSER_HOME:-$PWD/tools/.composer}" $COMPOSER install --working-dir=tools --no-interaction
        ;;
    lint)
        status=0
        out=$(find custom/Espo -name '*.php' -not -path '*/vendor/*' -print0 \
            | xargs -0 -n1 -P8 php -l -d display_errors=1 2>&1) || status=$?
        grep -v '^No syntax errors' <<<"$out" || true
        [[ $status -eq 0 ]] && echo "lint: OK"
        exit $status
        ;;
    cs)         require_tools; "$BIN/phpcs" "$@" ;;
    cs-fix)     require_tools; "$BIN/phpcbf" "$@" ;;
    rector)     require_tools; "$BIN/rector" process --dry-run "$@" ;;
    rector-fix) require_tools; "$BIN/rector" process "$@" ;;
    all)
        rc=0
        "$0" lint || rc=1
        "$0" cs "$@" || rc=1
        "$0" rector "$@" || rc=1
        exit $rc
        ;;
    *)
        sed -n '2,15p' "$0"
        exit 1
        ;;
esac
